# KIS API Credentials (모의투자용)
KIS_APP_KEY_PAPER=your_paper_app_key_here
KIS_APP_SECRET_PAPER=your_paper_app_secret_here
KIS_ACCOUNT_NUMBER_PAPER=your_paper_account_number_here

# KIS API Credentials (실전용)
KIS_APP_KEY_LIVE=your_live_app_key_here
KIS_APP_SECRET_LIVE=your_live_app_secret_here
KIS_ACCOUNT_NUMBER_LIVE=your_live_account_number_here

# Trading Mode
TRADING_MODE=paper  # paper or live

# Strategy Settings
STRATEGY_TYPE=ma_cross  # ma_cross, rsi, etc.
MA_SHORT_PERIOD=5
MA_LONG_PERIOD=20

# Risk Management
MAX_POSITION_RATIO=0.05  # 종목당 최대 5%
DAILY_LOSS_LIMIT=-50000  # 일일 최대 손실 -50,000원
STOP_LOSS_RATIO=0.05  # 손절 5%
TAKE_PROFIT_RATIO=0.10  # 익절 10%

# Notification
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SEND_NOTIFICATIONS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
